#!/bin/bash

# omarchy:summary=Open the standalone Files application
# omarchy:args=[route|omarchy-files://link] [options]
# omarchy:examples=omarchy launch files | omarchy launch files files.recent | omarchy launch files omarchy-files://search/results?query=report

set -euo pipefail

source "$OMARCHY_PATH/shell/apps/shared/launch-product-app.bash"
launch_product_app files "$@"

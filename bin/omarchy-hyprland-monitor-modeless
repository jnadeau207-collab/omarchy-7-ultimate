#!/bin/bash

# omarchy:summary=Returns true when Hyprland has an enabled monitor with no mode
# omarchy:hidden=true

monitors=$(hyprctl monitors all -j 2>/dev/null) || exit 2

state=$(jq 'if any(.[]; .disabled != true and (.width == 0 or .height == 0)) then 0 else 1 end' \
  <<<"$monitors" 2>/dev/null)

case $state in
  0 | 1) exit "$state" ;;
  *) exit 2 ;;
esac

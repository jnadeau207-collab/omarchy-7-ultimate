#!/bin/bash

# omarchy:summary=Prompt for required reboot or service restarts after updates

echo

confirm_reboot() {
  gum confirm "$1" && { omarchy-system-reboot; exit 0; }
}

running_kernel=$(uname -r)
kernel_updated=true

for kernel in /usr/lib/modules/*/vmlinuz; do
  if [[ -f $kernel ]] && pacman -Qo "$kernel" &>/dev/null; then
    installed_kernel=$(basename "$(dirname "$kernel")")

    if [[ $installed_kernel == $running_kernel ]]; then
      kernel_updated=false
      break
    fi
  fi
done

if [[ $kernel_updated == "true" ]]; then
  confirm_reboot "Linux kernel has been updated. Reboot?"
elif [[ -f $HOME/.local/state/omarchy/reboot-required ]]; then
  confirm_reboot "Updates require reboot. Ready?"
fi

running_hyprland=$(readlink /proc/$(pgrep -x Hyprland)/exe 2>/dev/null)
if [[ $running_hyprland == *"(deleted)"* ]]; then
  confirm_reboot "Hyprland has been updated. Reboot?"
fi

for file in "$HOME"/.local/state/omarchy/restart-*-required; do
  if [[ -f $file ]]; then
    filename=$(basename "$file")
    service=$(echo "$filename" | sed 's/restart-\(.*\)-required/\1/')
    echo "Restarting $service"
    omarchy-state clear "$filename"
    omarchy-restart-"$service"
  fi
done

fabric_refresh_status=0
fabric_wants_path="$HOME/.config/systemd/user/graphical-session.target.wants/omarchy-fabric.service"
if systemctl --user is-enabled --quiet omarchy-fabric.service ||
  systemctl --user is-active --quiet omarchy-fabric.service ||
  [[ -L $fabric_wants_path ]]; then
  echo -e "\e[32m\nRefreshing Fabric\e[0m"
  omarchy-fabric-service refresh
  fabric_lifecycle_status=$?
  if (( fabric_lifecycle_status == 78 )); then
    echo "Fabric stopped because its updated runtime could not be verified. Complete the package update before restarting it." >&2
    fabric_refresh_status=1
  elif (( fabric_lifecycle_status != 0 )); then
    echo "Fabric refresh failed and the previous daemon state is unknown. Do not use Fabric until its user service can be stopped and the package update completed." >&2
    fabric_refresh_status=1
  fi
fi

echo -e "\e[32m\nRestarting shell\e[0m"
echo "All plugins have been reloaded"
omarchy-restart-shell || true

exit "$fabric_refresh_status"

#!/bin/bash

# omarchy:summary=Run the provisional per-user Fabric daemon
# omarchy:hidden=true

set -euo pipefail

"$OMARCHY_PATH/bin/omarchy-fabric-service" verify-package

fabric_python_path="$OMARCHY_PATH/default/fabric"
if [[ -n ${PYTHONPATH:-} ]]; then
  fabric_python_path+=":$PYTHONPATH"
fi

export PYTHONPATH="$fabric_python_path"
exec /usr/bin/python3 -m omarchy_fabric.daemon "$@"

[Desktop Entry]
Version=1.0
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse trusted file metadata through the Omarchy Files provider
TryExec=omarchy-launch-files
Exec=omarchy-launch-files --source desktop %u
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
Keywords=files;folders;desktop;documents;downloads;pictures;trash;network;
MimeType=x-scheme-handler/omarchy-files;
StartupNotify=true
StartupWMClass=org.omarchy.Files
Actions=Home;ThisPC;Desktop;Documents;Downloads;Pictures;Music;Videos;Recent;Trash;Search;

[Desktop Action Home]
Name=Home
Exec=omarchy-launch-files --source desktop files.overview

[Desktop Action ThisPC]
Name=Computer
Exec=omarchy-launch-files --source desktop files.this-pc

[Desktop Action Desktop]
Name=Desktop
Exec=omarchy-launch-files --source desktop files.desktop

[Desktop Action Documents]
Name=Documents
Exec=omarchy-launch-files --source desktop files.documents

[Desktop Action Downloads]
Name=Downloads
Exec=omarchy-launch-files --source desktop files.downloads

[Desktop Action Pictures]
Name=Pictures
Exec=omarchy-launch-files --source desktop files.pictures

[Desktop Action Music]
Name=Music
Exec=omarchy-launch-files --source desktop files.music

[Desktop Action Videos]
Name=Videos
Exec=omarchy-launch-files --source desktop files.videos

[Desktop Action Recent]
Name=Recent
Exec=omarchy-launch-files --source desktop files.recent

[Desktop Action Trash]
Name=Recycle Bin
Exec=omarchy-launch-files --source desktop files.trash

[Desktop Action Search]
Name=Search
Exec=omarchy-launch-files --source desktop files.search

[Desktop Entry]
Version=1.0
Type=Application
Name=Settings
GenericName=System Settings
Comment=Configure Omarchy through typed system providers
TryExec=omarchy-launch-settings
Exec=omarchy-launch-settings --source desktop %u
Icon=preferences-system
Terminal=false
Categories=Settings;
Keywords=settings;display;sound;network;bluetooth;input;power;apps;defaults;accessibility;update;recovery;
MimeType=x-scheme-handler/omarchy-settings;
StartupNotify=true
StartupWMClass=org.omarchy.Settings
Actions=Display;Network;Personalization;Accessibility;Apps;

[Desktop Action Display]
Name=Display
Exec=omarchy-launch-settings --source desktop settings.display.overview

[Desktop Action Network]
Name=Network & Internet
Exec=omarchy-launch-settings --source desktop settings.network.overview

[Desktop Action Personalization]
Name=Personalization
Exec=omarchy-launch-settings --source desktop settings.personalization.overview

[Desktop Action Accessibility]
Name=Accessibility
Exec=omarchy-launch-settings --source desktop settings.accessibility.overview

[Desktop Action Apps]
Name=Apps
Exec=omarchy-launch-settings --source desktop settings.apps.overview

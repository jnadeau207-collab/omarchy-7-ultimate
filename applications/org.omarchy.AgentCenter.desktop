[Desktop Entry]
Version=1.0
Type=Application
Name=Agent Center
GenericName=Agent Tasks and Automations
Comment=Inspect managed agent work, approvals, automations, and trust
TryExec=omarchy-launch-agent-center
Exec=omarchy-launch-agent-center --source desktop %u
Icon=org.omarchy.AgentCenter
Terminal=false
Categories=System;
Keywords=agent;task;automation;approval;activity;usage;provider;history;context;permission;artifact;troubleshooting;
MimeType=x-scheme-handler/omarchy-agent;
StartupNotify=true
StartupWMClass=org.omarchy.AgentCenter
Actions=Tasks;Approvals;Automations;Activity;History;Context;Usage;Permissions;Providers;Artifacts;Troubleshooting;

[Desktop Action Tasks]
Name=Tasks & Runs
Exec=omarchy-launch-agent-center --source desktop agent.tasks

[Desktop Action Approvals]
Name=Pending Approvals
Exec=omarchy-launch-agent-center --source desktop agent.approvals

[Desktop Action Automations]
Name=Automations
Exec=omarchy-launch-agent-center --source desktop agent.automations

[Desktop Action Activity]
Name=Activity & operations
Exec=omarchy-launch-agent-center --source desktop agent.activity

[Desktop Action History]
Name=History
Exec=omarchy-launch-agent-center --source desktop agent.history

[Desktop Action Context]
Name=Context
Exec=omarchy-launch-agent-center --source desktop agent.context

[Desktop Action Usage]
Name=Usage
Exec=omarchy-launch-agent-center --source desktop agent.usage

[Desktop Action Permissions]
Name=Permissions & trust
Exec=omarchy-launch-agent-center --source desktop agent.permissions

[Desktop Action Providers]
Name=Providers & accounts
Exec=omarchy-launch-agent-center --source desktop agent.providers

[Desktop Action Artifacts]
Name=Artifacts
Exec=omarchy-launch-agent-center --source desktop agent.artifacts

[Desktop Action Troubleshooting]
Name=Troubleshooting
Exec=omarchy-launch-agent-center --source desktop agent.troubleshooting

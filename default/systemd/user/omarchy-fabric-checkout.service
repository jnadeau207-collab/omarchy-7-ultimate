[Unit]
Description=Run the Omarchy Fabric control plane from the session checkout
Documentation=file:///usr/share/doc/omarchy/agent-fabric-packaging.md
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=OMARCHY_PATH
ConditionPathExists=!/usr/bin/omarchy-fabricd
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-%t/uwsm/env_session.conf
ExecStartPre=/bin/bash -c '"$OMARCHY_PATH/bin/omarchy-fabric-service" prepare-start'
ExecStart=/bin/bash -c 'exec "$OMARCHY_PATH/bin/omarchy-fabricd"'
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=2
TimeoutStopSec=15
RuntimeDirectory=omarchy
RuntimeDirectoryMode=0700
StateDirectory=omarchy/fabric
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelModules=yes
# ProtectKernelTunables and ProtectKernelLogs remount procfs and block bubblewrap --proc.
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target

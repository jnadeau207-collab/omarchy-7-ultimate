{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:schema:compatibility-recipes-v0",
  "x-omarchy-version": "v0",
  "title": "Omarchy reviewed compatibility recipes",
  "type": "object",
  "required": ["schemaVersion", "revision", "assurance", "recipes"],
  "properties": {
    "schemaVersion": {"const": "v0"},
    "revision": {"$ref": "#/$defs/revision"},
    "assurance": {"type": "string", "enum": ["contract-seed", "release-verified"]},
    "recipes": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/recipe"}}
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160},
    "revision": {"type": "string", "pattern": "^sha256\\.[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "permission": {"type": "string", "enum": ["network", "audio", "camera", "microphone", "notifications", "filesystem-home", "filesystem-removable", "devices", "session"]},
    "step": {
      "type": "object",
      "required": ["id", "action", "reversible"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "action": {"type": "string", "enum": ["verify-artifact", "create-prefix", "install-runtime", "apply-permissions", "create-launcher", "validate-launch", "remove-runtime", "remove-launcher", "export-data"]},
        "reversible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["install", "validate", "remove", "export"],
      "properties": {
        "install": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/step"}},
        "validate": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/step"}},
        "remove": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/step"}},
        "export": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/step"}}
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["status", "keyId", "reviewRevision"],
      "properties": {
        "status": {"type": "string", "enum": ["declared", "verified"]},
        "keyId": {"type": "string", "minLength": 1, "maxLength": 160},
        "reviewRevision": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["id", "workloadId", "displayName", "version", "architecture", "artifact", "permissions", "hostRequirements", "lifecycle", "exportPolicy", "removalPlan", "signature"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "workloadId": {"$ref": "#/$defs/stableId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "architecture": {"type": "string", "enum": ["any", "x86_64", "aarch64"]},
        "artifact": {
          "type": "object",
          "required": ["origin", "digest"],
          "properties": {"origin": {"type": "string", "pattern": "^https://", "minLength": 1, "maxLength": 500}, "digest": {"$ref": "#/$defs/digest"}},
          "additionalProperties": false
        },
        "permissions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/permission"}},
        "hostRequirements": {
          "type": "object",
          "required": ["runtime", "minimumMemoryMiB", "minimumDiskMiB"],
          "properties": {"runtime": {"type": "string", "enum": ["wine", "proton", "container", "browser", "native"]}, "minimumMemoryMiB": {"type": "integer", "minimum": 128, "maximum": 262144}, "minimumDiskMiB": {"type": "integer", "minimum": 1, "maximum": 1048576}},
          "additionalProperties": false
        },
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "exportPolicy": {"type": "string", "enum": ["supported", "data-only", "unsupported"]},
        "removalPlan": {
          "type": "object",
          "required": ["preserve", "delete"],
          "properties": {"preserve": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}, "delete": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}},
          "additionalProperties": false
        },
        "signature": {"$ref": "#/$defs/signature"}
      },
      "additionalProperties": false
    }
  }
}

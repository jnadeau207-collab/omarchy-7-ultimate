{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:schema:packages-catalog-v0",
  "x-omarchy-version": "v0",
  "title": "Omarchy Software Center trusted catalog",
  "type": "object",
  "required": ["schemaVersion", "revision", "assurance", "generatedFrom", "sources", "entries"],
  "properties": {
    "schemaVersion": {"const": "v0"},
    "revision": {"type": "string", "pattern": "^sha256\\.[0-9a-f]{64}$"},
    "assurance": {"type": "string", "enum": ["contract-seed", "release-verified"]},
    "generatedFrom": {"type": "string", "minLength": 1, "maxLength": 160},
    "sources": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/source"}},
    "entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160},
    "sourceType": {"type": "string", "enum": ["curated", "signed-repo", "flatpak", "reviewed-aur", "appimage", "web-app"]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["id", "type", "title", "trustLevel", "signatureKeyId"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "type": {"$ref": "#/$defs/sourceType"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "trustLevel": {"type": "string", "enum": ["core", "signed", "reviewed", "sandboxed"]},
        "signatureKeyId": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160}
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["status", "keyId"],
      "properties": {
        "status": {"type": "string", "enum": ["declared", "verified", "reviewed", "not-applicable"]},
        "keyId": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["assurance", "publisher", "origin", "artifactDigest", "reviewRevision", "trustLevel", "signature"],
      "properties": {
        "assurance": {"type": "string", "enum": ["contract-seed", "release-verified"]},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 160},
        "origin": {"type": "string", "pattern": "^https://", "minLength": 1, "maxLength": 500},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "reviewRevision": {"$ref": "#/$defs/digest"},
        "trustLevel": {"type": "string", "enum": ["core", "signed", "reviewed", "sandboxed"]},
        "signature": {"$ref": "#/$defs/signature"}
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "required": ["requiredBytes", "permissions", "conflicts"],
      "properties": {
        "requiredBytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
        "permissions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "enum": ["network", "audio", "camera", "microphone", "notifications", "filesystem-home", "filesystem-removable", "devices", "session"]}},
        "conflicts": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "sourceId", "sourceType", "packageRef", "displayName", "summary", "version", "architecture", "keywords", "provenance", "install"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "sourceId": {"$ref": "#/$defs/stableId"},
        "sourceType": {"$ref": "#/$defs/sourceType"},
        "packageRef": {"type": "string", "minLength": 1, "maxLength": 300},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "architecture": {"type": "string", "enum": ["any", "x86_64", "aarch64"]},
        "keywords": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "install": {"$ref": "#/$defs/install"}
      },
      "additionalProperties": false
    }
  }
}

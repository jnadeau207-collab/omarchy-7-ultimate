{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:provider:files:rename-arguments:v0",
  "x-omarchy-version": "v0",
  "title": "Files rename arguments",
  "type": "object",
  "required": ["entryId", "newName"],
  "properties": {
    "entryId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160},
    "newName": {"type": "string", "minLength": 1, "maxLength": 255}
  },
  "additionalProperties": false
}

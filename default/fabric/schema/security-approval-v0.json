{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:schema:security-approval-v0",
  "title": "Exact operation approval binding",
  "type": "object",
  "required": [
    "schemaVersion",
    "approvalId",
    "correlationNonce",
    "operationId",
    "principalId",
    "sessionId",
    "capability",
    "resource",
    "providerVersion",
    "stateRevision",
    "risk",
    "argumentDigest",
    "bindingDigest",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "v0" },
    "approvalId": { "$ref": "common-v0.json#/$defs/stableId" },
    "correlationNonce": { "$ref": "common-v0.json#/$defs/uuid" },
    "operationId": { "$ref": "common-v0.json#/$defs/uuid" },
    "principalId": { "$ref": "common-v0.json#/$defs/stableId" },
    "sessionId": { "$ref": "common-v0.json#/$defs/stableId" },
    "capability": { "$ref": "common-v0.json#/$defs/capabilityId" },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "$ref": "common-v0.json#/$defs/stableId" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\\\\\u0000]+$" }
      },
      "additionalProperties": false
    },
    "providerVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
    "stateRevision": { "$ref": "common-v0.json#/$defs/stateRevision" },
    "risk": { "enum": ["low", "consequential", "high"] },
    "taskId": { "$ref": "common-v0.json#/$defs/stableId" },
    "argumentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bindingDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "consumedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

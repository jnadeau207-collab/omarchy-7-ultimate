{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:provider:defaults:association-preflight:v1",
  "x-omarchy-version": "v1",
  "title": "Default application operation preflight",
  "type": "object",
  "required": [
    "schemaVersion",
    "provider",
    "providerVersion",
    "action",
    "capability",
    "resource",
    "normalizedArguments",
    "stateRevision",
    "currentState",
    "proposedState",
    "changed",
    "summary",
    "risk",
    "effects",
    "guards",
    "recovery"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v0"
    },
    "provider": {
      "const": "defaults.provider"
    },
    "providerVersion": {
      "const": "v0"
    },
    "action": {
      "type": "string",
      "enum": [
        "mime.set",
        "protocol.set"
      ]
    },
    "capability": {
      "type": "string",
      "enum": [
        "defaults.mime.set",
        "defaults.protocol.set",
        "defaults.association.clear"
      ]
    },
    "resource": {
      "$ref": "#/$defs/resource"
    },
    "normalizedArguments": {
      "oneOf": [
        {
          "$ref": "urn:omarchy:fabric:provider:defaults:mime-set-arguments:v0"
        },
        {
          "$ref": "urn:omarchy:fabric:provider:defaults:protocol-set-arguments:v0"
        },
        {
          "$ref": "urn:omarchy:fabric:provider:defaults:clear-arguments:v0"
        }
      ]
    },
    "stateRevision": {
      "$ref": "urn:omarchy:fabric:provider:defaults:operation-state:v0#/$defs/revision"
    },
    "currentState": {
      "$ref": "urn:omarchy:fabric:provider:defaults:association-state:v1"
    },
    "proposedState": {
      "$ref": "urn:omarchy:fabric:provider:defaults:association-state:v1"
    },
    "changed": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "risk": {
      "const": "low"
    },
    "effects": {
      "type": "array",
      "const": [
        "mutating"
      ]
    },
    "guards": {
      "$ref": "#/$defs/guards"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "defaults.association"
        },
        "id": {
          "type": "string",
          "pattern": "^defaults\\.association\\.[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "executor": {
      "type": "object",
      "required": [
        "mode",
        "commandId",
        "shell"
      ],
      "properties": {
        "mode": {
          "const": "typed-helper"
        },
        "commandId": {
          "const": "defaults.apply-v0"
        },
        "shell": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "guards": {
      "type": "object",
      "required": [
        "snapshotRevision",
        "associationId",
        "associationRevision",
        "applicationRevision",
        "executor"
      ],
      "properties": {
        "snapshotRevision": {
          "$ref": "urn:omarchy:fabric:provider:defaults:operation-state:v0#/$defs/revision"
        },
        "associationId": {
          "$ref": "urn:omarchy:fabric:provider:defaults:operation-state:v0#/$defs/stableId"
        },
        "associationRevision": {
          "$ref": "urn:omarchy:fabric:provider:defaults:operation-state:v0#/$defs/revision"
        },
        "applicationRevision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:omarchy:fabric:provider:defaults:operation-state:v0#/$defs/revision"
            }
          ]
        },
        "executor": {
          "$ref": "#/$defs/executor"
        }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": [
        "mode",
        "priorState"
      ],
      "properties": {
        "mode": {
          "const": "undo"
        },
        "priorState": {
          "$ref": "urn:omarchy:fabric:provider:defaults:operation-state:v0"
        }
      },
      "additionalProperties": false
    }
  }
}

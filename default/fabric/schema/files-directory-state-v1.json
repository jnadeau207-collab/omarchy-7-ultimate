{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:provider:files:directory-state:v1",
  "x-omarchy-version": "v1",
  "title": "Files directory operation state",
  "type": "object",
  "required": [
    "resourceId",
    "revision",
    "value"
  ],
  "properties": {
    "resourceId": {
      "type": "string",
      "pattern": "^files\\.directory\\.[0-9a-f]{64}$"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "value": {
      "$ref": "#/$defs/directory"
    },
    "recoveryFromRevision": {
      "$ref": "#/$defs/revision"
    },
    "recoveryAction": {
      "type": "string",
      "enum": [
        "directory.create",
        "entry.rename",
        "entry.copy",
        "entry.move",
        "entry.delete",
        "entry.trash",
        "trash.restore",
        "entry.open"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256\\.[0-9a-f]{64}$"
    },
    "directory": {
      "type": "object",
      "required": [
        "locationId",
        "parentRelativePath",
        "names"
      ],
      "properties": {
        "locationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 160
        },
        "parentRelativePath": {
          "type": "string",
          "maxLength": 1024
        },
        "names": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "selectedEntry": {
          "$ref": "#/$defs/selectedEntry"
        }
      },
      "additionalProperties": false
    },
    "selectedEntry": {
      "type": "object",
      "required": [
        "entryId",
        "identity"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 160
        },
        "identity": {
          "$ref": "#/$defs/revision"
        }
      },
      "additionalProperties": false
    }
  }
}

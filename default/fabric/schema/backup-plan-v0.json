{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:schema:backup-plan-v0",
  "x-omarchy-version": "v0",
  "title": "Home backup and restore plan",
  "type": "object",
  "required": ["schemaVersion", "action", "scope", "engine", "snapshotId", "relativePath", "retention", "threats", "revision"],
  "properties": {
    "schemaVersion": { "const": "v0" },
    "action": { "enum": ["snapshot", "prune", "restore"] },
    "scope": { "const": "home" },
    "engine": { "const": "restic" },
    "snapshotId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{8,64}$" }] },
    "relativePath": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^(?=.{1,512}$)(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9._ @+-]+(?:/[A-Za-z0-9._ @+-]+){0,31}$" }] },
    "retention": { "$ref": "#/$defs/retention" },
    "threats": { "type": "array", "const": ["accidental-deletion", "disk-failure", "malware", "repository-loss"] },
    "revision": { "type": "string", "pattern": "^sha256\\.[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "restore" } }, "required": ["action"] },
      "then": { "properties": { "snapshotId": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" }, "relativePath": { "type": "string", "pattern": "^(?=.{1,512}$)(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9._ @+-]+(?:/[A-Za-z0-9._ @+-]+){0,31}$" } } },
      "else": { "properties": { "snapshotId": { "type": "null" }, "relativePath": { "type": "null" } } }
    }
  ],
  "$defs": {
    "retention": {
      "type": "object",
      "required": ["daily", "weekly", "monthly"],
      "properties": {
        "daily": { "type": "integer", "minimum": 1, "maximum": 365 },
        "weekly": { "type": "integer", "minimum": 1, "maximum": 260 },
        "monthly": { "type": "integer", "minimum": 1, "maximum": 120 }
      },
      "additionalProperties": false
    }
  }
}

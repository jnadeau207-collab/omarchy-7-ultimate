{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:provider:files:directory-preflight:v1",
  "x-omarchy-version": "v1",
  "title": "Files directory operation preflight",
  "type": "object",
  "required": [
    "schemaVersion",
    "provider",
    "providerVersion",
    "action",
    "capability",
    "resource",
    "normalizedArguments",
    "stateRevision",
    "currentState",
    "proposedState",
    "changed",
    "summary",
    "risk",
    "effects",
    "guards",
    "recovery"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v0"
    },
    "provider": {
      "const": "files.provider"
    },
    "providerVersion": {
      "const": "v0"
    },
    "action": {
      "enum": [
        "directory.create",
        "entry.trash",
        "trash.restore",
        "entry.open"
      ]
    },
    "capability": {
      "type": "string",
      "enum": [
        "files.directory.create",
        "files.entry.rename",
        "files.entry.trash",
        "files.trash.restore",
        "files.entry.open",
        "files.mount.connect",
        "files.mount.disconnect"
      ]
    },
    "resource": {
      "$ref": "#/$defs/resource"
    },
    "normalizedArguments": {
      "oneOf": [
        {
          "$ref": "urn:omarchy:fabric:provider:files:create-directory-arguments:v0"
        },
        {
          "$ref": "urn:omarchy:fabric:provider:files:rename-arguments:v0"
        },
        {
          "$ref": "urn:omarchy:fabric:provider:files:entry-arguments:v0"
        },
        {
          "$ref": "urn:omarchy:fabric:provider:files:mount-arguments:v0"
        }
      ]
    },
    "stateRevision": {
      "$ref": "urn:omarchy:fabric:provider:files:operation-state:v0#/$defs/revision"
    },
    "currentState": {
      "$ref": "urn:omarchy:fabric:provider:files:directory-state:v1"
    },
    "proposedState": {
      "$ref": "urn:omarchy:fabric:provider:files:directory-state:v1"
    },
    "changed": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "consequential"
      ]
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "mutating",
          "network",
          "launch"
        ]
      }
    },
    "guards": {
      "$ref": "#/$defs/guards"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "files.directory"
        },
        "id": {
          "type": "string",
          "pattern": "^files\\.directory\\.[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": [
        "resourceId",
        "identity"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 160
        },
        "identity": {
          "$ref": "urn:omarchy:fabric:provider:files:operation-state:v0#/$defs/revision"
        }
      },
      "additionalProperties": false
    },
    "guards": {
      "type": "object",
      "required": [
        "snapshotRevision",
        "pathPolicy",
        "noFollow",
        "anchors"
      ],
      "properties": {
        "snapshotRevision": {
          "$ref": "urn:omarchy:fabric:provider:files:operation-state:v0#/$defs/revision"
        },
        "pathPolicy": {
          "const": "location-relative-v0"
        },
        "noFollow": {
          "const": true
        },
        "anchors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "selectedEntry": {
          "$ref": "#/$defs/selectedEntry"
        }
      },
      "additionalProperties": false
    },
    "selectedEntry": {
      "type": "object",
      "required": [
        "entryId",
        "locationId",
        "entryRelativePath"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 160
        },
        "locationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 160
        },
        "entryRelativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": [
        "mode",
        "priorState"
      ],
      "properties": {
        "mode": {
          "const": "undo"
        },
        "priorState": {
          "$ref": "urn:omarchy:fabric:provider:files:operation-state:v0"
        }
      },
      "additionalProperties": false
    }
  }
}

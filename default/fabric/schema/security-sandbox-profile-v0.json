{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:schema:security-sandbox-profile-v0",
  "title": "Fail-closed managed-task sandbox profile",
  "type": "object",
  "required": ["schemaVersion", "profileId", "taskId", "exposure", "binds", "network"],
  "properties": {
    "schemaVersion": { "const": "v0" },
    "profileId": { "$ref": "common-v0.json#/$defs/stableId" },
    "taskId": { "$ref": "common-v0.json#/$defs/stableId" },
    "exposure": {
      "type": "object",
      "required": ["home", "wayland", "sessionBus", "sshAgent", "browserProfiles", "keyring", "mainFabricSocket", "hostNetwork"],
      "properties": {
        "home": { "const": false },
        "wayland": { "const": false },
        "sessionBus": { "const": false },
        "sshAgent": { "const": false },
        "browserProfiles": { "const": false },
        "keyring": { "const": false },
        "mainFabricSocket": { "const": false },
        "hostNetwork": { "const": false }
      },
      "additionalProperties": false
    },
    "binds": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["source", "sourceRoot", "target", "writable"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "sourceRoot": { "type": "string", "minLength": 1 },
          "target": {
            "type": "string",
            "pattern": "^/(?:workspace|artifacts)/[A-Za-z0-9._/-]+$",
            "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)|//" }
          },
          "writable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "required": ["mode", "scopes"],
      "properties": {
        "mode": { "enum": ["none", "task-proxy"] },
        "scopes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["protocol", "host", "port"],
            "properties": {
              "protocol": { "const": "https" },
              "host": { "type": "string", "minLength": 1, "maxLength": 253 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
          "then": { "properties": { "scopes": { "maxItems": 0 } } },
          "else": { "properties": { "scopes": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:fabric:provider:files:copy-arguments:v0",
  "x-omarchy-version": "v0",
  "title": "Files copy arguments",
  "type": "object",
  "required": ["entryId", "destinationLocationId", "destinationParentRelativePath", "destinationName"],
  "properties": {
    "entryId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160},
    "destinationLocationId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160},
    "destinationParentRelativePath": {"type": "string", "maxLength": 1024},
    "destinationName": {"type": "string", "minLength": 1, "maxLength": 255}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:ultimate:capability-schema:parity-jobs-v0",
  "title": "Omarchy Ultimate parity and Windows-native job graph",
  "type": "object",
  "required": ["$schema", "schemaVersion", "jobs"],
  "properties": {
    "$schema": { "const": "urn:omarchy:ultimate:capability-schema:parity-jobs-v0" },
    "schemaVersion": { "const": "v0" },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "sourceLabel", "sourceStatus", "claim", "capabilityIds", "humanRoute", "agentAvailability", "recoveryExpectation", "proofStatus", "proofIds", "source"],
        "properties": {
          "id": { "$ref": "urn:omarchy:fabric:schema:common-v0#/$defs/stableId" },
          "kind": { "type": "string", "enum": ["parity-job", "windows-native-task"] },
          "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sourceStatus": { "type": "string", "minLength": 1, "maxLength": 160 },
          "claim": { "type": "string", "enum": ["missing", "plumbing", "prototype", "partial", "present"] },
          "capabilityIds": { "type": "array", "items": { "$ref": "urn:omarchy:fabric:schema:common-v0#/$defs/capabilityId" }, "minItems": 1, "uniqueItems": true },
          "humanRoute": {
            "type": "object",
            "required": ["status", "surface", "path"],
            "properties": {
              "status": { "type": "string", "enum": ["visible", "planned", "missing"] },
              "surface": { "type": "string", "minLength": 1, "maxLength": 240 },
              "path": { "type": "string", "maxLength": 500 }
            },
            "additionalProperties": false
          },
          "agentAvailability": { "type": "string", "enum": ["present", "unavailable"] },
          "recoveryExpectation": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "proofStatus": { "type": "string", "enum": ["tree-audit", "pending", "manual", "automated"] },
          "proofIds": { "type": "array", "items": { "$ref": "urn:omarchy:fabric:schema:common-v0#/$defs/stableId" }, "minItems": 1, "uniqueItems": true },
          "source": {
            "type": "object",
            "required": ["file", "section", "row"],
            "properties": {
              "file": { "type": "string", "minLength": 1, "maxLength": 500 },
              "section": { "type": "string", "minLength": 1, "maxLength": 240 },
              "row": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}

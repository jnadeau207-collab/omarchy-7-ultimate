{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:ultimate:capability-schema:legacy-debt-v0",
  "title": "Omarchy Ultimate checked capability migration debt",
  "type": "object",
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": { "const": "urn:omarchy:ultimate:capability-schema:legacy-debt-v0" },
    "schemaVersion": { "const": "v0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "capabilityIds", "surfaceRefs", "reason", "removalGate"],
        "properties": {
          "id": { "$ref": "urn:omarchy:fabric:schema:common-v0#/$defs/stableId" },
          "state": { "type": "string", "enum": ["legacy-direct", "provider-missing", "agent-unavailable"] },
          "capabilityIds": { "type": "array", "items": { "$ref": "urn:omarchy:fabric:schema:common-v0#/$defs/capabilityId" }, "minItems": 1, "uniqueItems": true },
          "surfaceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(window-service|window-ipc|capability):[A-Za-z0-9_.-]+$" }, "minItems": 1, "uniqueItems": true },
          "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "removalGate": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "additionalProperties": false
      },
      "minItems": 3
    }
  },
  "additionalProperties": false
}

{
  "$schema": "urn:omarchy:ultimate:product-contracts:invocations-v0",
  "schemaVersion": "v0",
  "contractStatus": "provisional-v0",
  "contextContract": {
    "requiredFields": ["invocationId", "screen.logicalId", "screen.connector", "screen.edidHash", "anchorRect", "seatId", "route", "focusRestoration"],
    "monitorResolutionOrder": ["exact live logical screen plus connector and EDID hash", "same EDID hash on its current connector", "same connector when EDID is unavailable", "primary screen only after an explicit fallback decision"],
    "reopenRule": "A surface reopens on its last live owner only when that owner still matches the invocation context; otherwise it resolves the invoking screen again and records the fallback.",
    "focusRule": "Open captures a stable restoration target and close restores it unless the invocation launched or deliberately focused a different target; a vanished target resolves to an explicit no-restore result."
  },
  "monitorSemantics": [
    {
      "id": "monitor.contract.invoker-v0",
      "state": "contract",
      "deterministic": true,
      "acceptsScreenIdentity": true,
      "acceptsConnector": true,
      "acceptsEdidHash": true,
      "acceptsAnchorRect": true,
      "acceptsSeat": true,
      "reopenPlacement": "invoking-monitor",
      "selection": "Resolve the exact live screen tuple, constrain the anchor to its work area, and persist the resolved owner with the route instance.",
      "debtIds": []
    },
    {
      "id": "monitor.legacy.global-default",
      "state": "legacy-unbound",
      "deterministic": false,
      "acceptsScreenIdentity": false,
      "acceptsConnector": false,
      "acceptsEdidHash": false,
      "acceptsAnchorRect": false,
      "acceptsSeat": false,
      "reopenPlacement": "component-specific",
      "selection": "The loader or PanelWindow chooses its default screen and internal anchors; the shell route supplies no monitor context.",
      "debtIds": ["debt.invocation.context-missing"]
    },
    {
      "id": "monitor.legacy.first-bar-instance",
      "state": "legacy-unbound",
      "deterministic": false,
      "acceptsScreenIdentity": false,
      "acceptsConnector": false,
      "acceptsEdidHash": false,
      "acceptsAnchorRect": false,
      "acceptsSeat": false,
      "reopenPlacement": "component-specific",
      "selection": "Bar.findPanelWidget returns the first loaded matching widget, independent of the invoking monitor, pointer, and seat.",
      "debtIds": ["debt.invocation.context-missing", "debt.invocation.first-bar-instance"]
    }
  ],
  "focusSemantics": [
    {
      "id": "focus.contract.restore-v0",
      "state": "contract",
      "deterministic": true,
      "capturesTarget": true,
      "restoresOnDismiss": true,
      "policy": "Capture the requested stable target, distinguish launch and click-through transfer, and return a typed restored, transferred, vanished, or no-target result.",
      "debtIds": []
    },
    {
      "id": "focus.legacy.component-specific",
      "state": "legacy-ad-hoc",
      "deterministic": false,
      "capturesTarget": false,
      "restoresOnDismiss": false,
      "policy": "Each component handles keyboard grabs and dismissal locally; the route has no restoration target or typed focus outcome.",
      "debtIds": ["debt.focus.component-specific"]
    },
    {
      "id": "focus.legacy.start-partial",
      "state": "partial",
      "deterministic": false,
      "capturesTarget": true,
      "restoresOnDismiss": false,
      "policy": "Start remembers the active toplevel and implements proven pointer click-through, but it does not accept or report the shared restoration contract.",
      "debtIds": ["debt.focus.component-specific"]
    }
  ],

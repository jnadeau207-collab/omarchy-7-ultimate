{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:ultimate:product-contracts:search-v0",
  "title": "Omarchy provisional normalized search contract and inventory v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractStatus", "resultContract", "providers"],
  "properties": {
    "$schema": { "const": "urn:omarchy:ultimate:product-contracts:search-v0" },
    "schemaVersion": { "const": "v0" },
    "contractStatus": { "const": "provisional-v0" },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "identityRule", "provenanceRule", "rankingRule", "mutationRule"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": { "enum": ["id", "source", "provenance", "title", "subtitle", "icon", "action", "secondaryActions", "trust", "destructive", "route", "rank"] }
        },
        "identityRule": { "type": "string", "minLength": 1 },
        "provenanceRule": { "type": "string", "minLength": 1 },
        "rankingRule": { "type": "string", "minLength": 1 },
        "mutationRule": { "type": "string", "minLength": 1 }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "consumers", "implementationPaths", "availability", "normalizedResult", "provenance", "actions", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "enum": ["desktop-entries", "menu-tree", "settings", "desktop", "files", "software", "agent-center"] },
          "consumers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "implementationPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
          "availability": { "enum": ["present-contract", "legacy-outside-contract", "absent"] },
          "normalizedResult": { "type": "boolean" },
          "provenance": { "enum": ["complete", "partial", "none"] },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "mutating", "eligibleForNormalizedSearch", "capabilityIds", "humanRoutes"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "type": { "enum": ["launch", "route", "capability", "legacy-command"] },
                "mutating": { "type": "boolean" },
                "eligibleForNormalizedSearch": { "type": "boolean" },
                "capabilityIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
                "humanRoutes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "debtIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. /-]+$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:ultimate:product-contracts:ipc-v0",
  "title": "Omarchy provisional shell IPC inventory v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractStatus", "endpoints"],
  "properties": {
    "$schema": { "const": "urn:omarchy:ultimate:product-contracts:ipc-v0" },
    "schemaVersion": { "const": "v0" },
    "contractStatus": { "const": "provisional-v0" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "sourcePath", "handlerKind", "pluginId", "methods", "processId", "principalBinding", "state", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "target": { "$ref": "#/$defs/target" },
          "sourcePath": { "$ref": "#/$defs/path" },
          "handlerKind": { "enum": ["declared", "dynamic-target", "inherited-panel"] },
          "pluginId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "methods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" } },
          "processId": { "$ref": "#/$defs/id" },
          "principalBinding": { "enum": ["endpoint-bound", "legacy-owner-socket-only", "none"] },
          "state": { "enum": ["present-contract", "present-legacy"] },
          "debtIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. /-]+$" }
  }
}

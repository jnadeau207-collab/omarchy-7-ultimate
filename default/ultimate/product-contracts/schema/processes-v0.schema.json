{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:ultimate:product-contracts:processes-v0",
  "title": "Omarchy provisional process and mutation ownership inventory v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractStatus", "principals", "processes", "invocationComponents"],
  "properties": {
    "$schema": { "const": "urn:omarchy:ultimate:product-contracts:processes-v0" },
    "schemaVersion": { "const": "v0" },
    "contractStatus": { "const": "provisional-v0" },
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "bindingState", "description", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "scope": { "enum": ["shared-shell", "desktop-application", "compositor", "external"] },
          "bindingState": { "enum": ["endpoint-bound", "process-bound", "legacy-shared", "legacy-dynamic", "external"] },
          "description": { "type": "string", "minLength": 1 },
          "debtIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "principalId", "ownerPath", "executable", "state", "owns", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "principalId": { "$ref": "#/$defs/id" },
          "ownerPath": { "type": ["string", "null"], "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. /-]+$" },
          "executable": { "type": "string", "minLength": 1 },
          "state": { "enum": ["present", "dynamic", "external", "absent"] },
          "owns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "debtIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "invocationComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "componentKind", "processId", "processRole", "mutationClass", "claimsProcessOwnership", "capabilityIds", "humanRoutes", "state", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/path" },
          "componentKind": { "enum": ["consumer-ui", "provider", "host-infrastructure"] },
          "processId": { "$ref": "#/$defs/id" },
          "processRole": { "enum": ["consumer", "provider", "owner"] },
          "mutationClass": { "enum": ["read-only", "session", "persistent", "mixed"] },
          "claimsProcessOwnership": { "type": "boolean" },
          "capabilityIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "humanRoutes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "state": { "enum": ["typed-provider", "legacy-direct", "read-only"] },
          "debtIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. /-]+$" }
  }
}

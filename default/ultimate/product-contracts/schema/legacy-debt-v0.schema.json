{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:ultimate:product-contracts:legacy-debt-v0",
  "title": "Omarchy provisional product-contract legacy debt inventory v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractStatus", "debts"],
  "properties": {
    "$schema": { "const": "urn:omarchy:ultimate:product-contracts:legacy-debt-v0" },
    "schemaVersion": { "const": "v0" },
    "contractStatus": { "const": "provisional-v0" },
    "debts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "summary", "impact", "exitCondition", "evidencePaths"],
        "properties": {
          "id": { "type": "string", "pattern": "^debt\\.[a-z0-9][a-z0-9._-]*$" },
          "state": { "const": "open" },
          "summary": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "exitCondition": { "type": "string", "minLength": 1 },
          "evidencePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_. /-]+$" } }
        }
      }
    }
  }
}

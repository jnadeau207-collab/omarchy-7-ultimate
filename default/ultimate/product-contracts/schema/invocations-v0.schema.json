{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy:ultimate:product-contracts:invocations-v0",
  "title": "Omarchy provisional surface invocation inventory v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractStatus", "contextContract", "monitorSemantics", "focusSemantics", "routes"],
  "properties": {
    "$schema": { "const": "urn:omarchy:ultimate:product-contracts:invocations-v0" },
    "schemaVersion": { "const": "v0" },
    "contractStatus": { "const": "provisional-v0" },
    "contextContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "monitorResolutionOrder", "reopenRule", "focusRule"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 8,
          "items": { "enum": ["invocationId", "screen.logicalId", "screen.connector", "screen.edidHash", "anchorRect", "seatId", "route", "focusRestoration"] }
        },
        "monitorResolutionOrder": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reopenRule": { "type": "string", "minLength": 1 },
        "focusRule": { "type": "string", "minLength": 1 }
      }
    },
    "monitorSemantics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "deterministic", "acceptsScreenIdentity", "acceptsConnector", "acceptsEdidHash", "acceptsAnchorRect", "acceptsSeat", "reopenPlacement", "selection", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "state": { "enum": ["contract", "partial", "legacy-unbound"] },
          "deterministic": { "type": "boolean" },
          "acceptsScreenIdentity": { "type": "boolean" },
          "acceptsConnector": { "type": "boolean" },
          "acceptsEdidHash": { "type": "boolean" },
          "acceptsAnchorRect": { "type": "boolean" },
          "acceptsSeat": { "type": "boolean" },
          "reopenPlacement": { "enum": ["invoking-monitor", "last-monitor-if-present", "primary-monitor", "component-specific", "unspecified"] },
          "selection": { "type": "string", "minLength": 1 },
          "debtIds": { "$ref": "#/$defs/debtIds" }
        }
      }
    },
    "focusSemantics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "deterministic", "capturesTarget", "restoresOnDismiss", "policy", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "state": { "enum": ["contract", "partial", "legacy-ad-hoc"] },
          "deterministic": { "type": "boolean" },
          "capturesTarget": { "type": "boolean" },
          "restoresOnDismiss": { "type": "boolean" },
          "policy": { "type": "string", "minLength": 1 },
          "debtIds": { "$ref": "#/$defs/debtIds" }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pluginId", "target", "operations", "payload", "monitorSemanticsId", "focusSemanticsId", "processId", "humanRoute", "state", "debtIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "pluginId": { "$ref": "#/$defs/id" },
          "target": { "const": "shell" },
          "operations": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "enum": ["summon", "toggle", "hide"] } },
          "payload": { "enum": ["legacy-opaque-json", "typed-invocation-v0"] },
          "monitorSemanticsId": { "$ref": "#/$defs/id" },
          "focusSemanticsId": { "$ref": "#/$defs/id" },
          "processId": { "$ref": "#/$defs/id" },
          "humanRoute": { "type": "string", "minLength": 1 },
          "state": { "enum": ["present-contract", "present-legacy", "absent"] },
          "debtIds": { "$ref": "#/$defs/debtIds" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "debtIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}

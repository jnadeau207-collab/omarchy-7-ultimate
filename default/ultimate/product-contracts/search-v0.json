{
  "$schema": "urn:omarchy:ultimate:product-contracts:search-v0",
  "schemaVersion": "v0",
  "contractStatus": "provisional-v0",
  "resultContract": {
    "requiredFields": ["id", "source", "provenance", "title", "subtitle", "icon", "action", "secondaryActions", "trust", "destructive", "route", "rank"],
    "identityRule": "A result id is stable within its source, includes the source namespace, and never derives from display text or list position.",
    "provenanceRule": "Every result identifies the provider, provider version, source record identity, capture revision, and whether the data is local, installed, indexed, or remote.",
    "rankingRule": "Providers return local match metadata; the consumer applies one deterministic tie-break sequence and never lets a web result replace a local exact application, route, setting, file, capability, or task match.",
    "mutationRule": "A normalized mutating action is ineligible unless it references at least one registered capability id and one visible human route and carries trust, destructive, preflight, and recovery metadata."
  },

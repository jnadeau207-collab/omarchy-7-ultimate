      "implementationPaths": ["shell/services/AppLibrary.qml", "shell/services/AppSearch.js", "shell/plugins/ultimate-start/Start.qml"],
      "availability": "legacy-outside-contract",
      "normalizedResult": false,
      "provenance": "partial",
      "actions": [
        { "id": "action.start.launch-desktop-entry", "type": "launch", "mutating": false, "eligibleForNormalizedSearch": false, "capabilityIds": [], "humanRoutes": ["route.surface.omarchy.ultimate-start"] }
      ],
      "debtIds": ["debt.search.legacy-result-shapes", "debt.identity.heuristic-window-join"]
    },
    {

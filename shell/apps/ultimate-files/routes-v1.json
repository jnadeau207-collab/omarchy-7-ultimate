      "description": "Bounded metadata for the canonical Documents location without reading file contents.",
      "keywords": ["documents", "folder", "files"],
      "providerId": "files.provider",
      "deepLink": { "host": "documents", "path": "" },
      "argumentSchema": {}
    },
    {
      "id": "files.downloads",
      "section": "Locations",
      "title": "Downloads",
      "description": "Bounded metadata for the canonical Downloads location without reading file contents.",
      "keywords": ["downloads", "folder", "files"],
      "providerId": "files.provider",
      "deepLink": { "host": "downloads", "path": "" },
      "argumentSchema": {}
    },
    {
      "id": "files.pictures",
      "section": "Locations",
      "title": "Pictures",

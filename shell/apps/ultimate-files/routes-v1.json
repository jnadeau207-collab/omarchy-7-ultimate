      "providerId": "files.provider",
      "deepLink": { "host": "overview", "path": "" },
      "argumentSchema": {
        "entityType": { "type": "enum", "values": ["location"], "optional": true },
        "entityId": { "type": "opaque-id", "optional": true }
      }
    },
    {
